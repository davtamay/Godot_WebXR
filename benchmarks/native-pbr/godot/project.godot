config_version=5
[application]
config/name="Native PBR regression benchmark"
run/main_scene="res://xbench.tscn"
[display]
window/size/viewport_width=1280
window/size/viewport_height=720
[rendering]
renderer/rendering_method="forward_plus"
renderer/rendering_method.web="forward_plus"
rendering_device/driver.web="webgpu"
environment/defaults/default_clear_color=Color(0,0,0,1)
[editor_plugins]
enabled=PackedStringArray("res://addons/godot_webgpu/plugin.cfg")
