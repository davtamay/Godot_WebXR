[node name="CanvasLayer" type="CanvasLayer" parent="." groups=["xr_session_hidden"]]

[node name="Panel" type="PanelContainer" parent="CanvasLayer"]
offsets_preset = 1
offset_left = 24.0
offset_top = 24.0
offset_right = 560.0
offset_bottom = 512.0

[node name="MarginContainer" type="MarginContainer" parent="CanvasLayer/Panel"]
layout_mode = 2
theme_override_constants/margin_left = 14
theme_override_constants/margin_top = 14
theme_override_constants/margin_right = 14
theme_override_constants/margin_bottom = 14

[node name="VBoxContainer" type="VBoxContainer" parent="CanvasLayer/Panel/MarginContainer"]
layout_mode = 2

[node name="TitleLabel" type="Label" parent="CanvasLayer/Panel/MarginContainer/VBoxContainer"]
layout_mode = 2
text = "Godot XR Interaction Toolkit Sample"

[node name="StatusLabel" type="Label" parent="CanvasLayer/Panel/MarginContainer/VBoxContainer"]
unique_name_in_owner = true
layout_mode = 2
text = "Choose VR or AR, then use rays to hover, grab, and use sample objects."
autowrap_mode = 3

[node name="SessionButtons" type="HBoxContainer" parent="CanvasLayer/Panel/MarginContainer/VBoxContainer"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="EnterVRButton" type="Button" parent="CanvasLayer/Panel/MarginContainer/VBoxContainer/SessionButtons"]
layout_mode = 2
size_flags_horizontal = 3
text = "Enter VR"

[node name="EnterARButton" type="Button" parent="CanvasLayer/Panel/MarginContainer/VBoxContainer/SessionButtons"]
layout_mode = 2
size_flags_horizontal = 3
text = "Enter AR"

[node name="FpsLabel" type="Label" parent="CanvasLayer/Panel/MarginContainer/VBoxContainer"]
unique_name_in_owner = true
layout_mode = 2
text = "FPS"

[node name="CapsLabel" type="Label" parent="CanvasLayer/Panel/MarginContainer/VBoxContainer"]
unique_name_in_owner = true
layout_mode = 2
text = "Capabilities"
autowrap_mode = 3

[node name="BrowserCapabilities" type="Control" parent="CanvasLayer"]
script = ExtResource("3_caps")
