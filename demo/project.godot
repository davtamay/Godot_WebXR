; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Godot XR Samples"
run/main_scene="res://scenes/launcher.tscn"
config/features=PackedStringArray("4.8", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

XRSceneRouter="*res://scripts/xr_scene_router.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_xr_interaction_toolkit/plugin.cfg", "res://addons/godot_webgpu/plugin.cfg", "res://addons/godot_universal_xr_apk/plugin.cfg")

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="mobile"
renderer/rendering_method.mobile="gl_compatibility"
renderer/rendering_method.web="mobile"
textures/vram_compression/import_etc2_astc=true
textures/default_filters/anisotropic_filtering_level=4
rendering_device/driver.web="webgpu"

[xr]

openxr/enabled=true
openxr/environment_blend_mode=2
openxr/default_action_map="res://addons/godot_webxr_kit/openxr/default_action_map.tres"
openxr/reference_space=2
openxr/extensions/hand_tracking=true
openxr/extensions/meta/passthrough=true
openxr/extensions/meta/scene_api=true
openxr/extensions/meta/environment_depth=true
openxr/extensions/androidxr/scene_meshing=true
openxr/extensions/androidxr/environment_depth=true
